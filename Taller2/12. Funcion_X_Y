Algoritmo Funcion_X_Y
	Definir X, Y1 Como Real
		
		Escribir "Ingrese el valor de X:"
		Leer X
		
		Si X < -4 Entonces
			Y1 <- 3.15 * X + 5.25
		SiNo
			Si X >= -4 Y X < 4 Entonces
				Y1 <- X^2 - 16
			SiNo
				Si X >= 4 Y X < 35 Entonces
					Y1 <- 4.12 * X - 5
				SiNo
					Si X >= 35 Entonces
						Y1 <- X^5 - 7 * X
					FinSi
				FinSi
			FinSi
		FinSi
		
		Escribir "El valor de Y es: ", Y1
FinAlgoritmo
